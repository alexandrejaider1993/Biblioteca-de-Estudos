class GerenciadorArquivos:
    def __init__(self, raiz):
        self.raiz = raiz
        self.cache = {"data": None, "mtime": -1} # Inicializado em -1 para forçar leitura mesmo com pastas vazias

    def listar(self):
        max_mtime, estrutura = self._varrer()
        if self.cache["mtime"] < max_mtime or self.cache["data"] is None:
            self.cache["data"] = estrutura
            self.cache["mtime"] = max_mtime
        return self.cache["data"]

    def _varrer(self):
        """Faz uma única passada pela árvore de diretórios, calculando o mtime
        máximo e já montando a estrutura ao mesmo tempo (evita dois os.walk)."""
        g = {}
        max_mtime = 0
        for root, dirs, files in os.walk(self.raiz):
            dirs[:] = [d for d in dirs if not ignorar(d)]

            site = novo_site(root) if root != self.raiz else None
            if site:
                rel_root = relativo(root)
                pai = os.path.dirname(rel_root)
                g.setdefault(pai, []).append(site[1])
                try:
                    max_mtime = max(max_mtime, os.path.getmtime(os.path.join(root, "index.html")))
                except OSError:
                    pass
                dirs[:] = []
                continue

            rel_root = os.path.relpath(root, self.raiz).replace(os.sep, "/")
            if rel_root == ".":
                rel_root = ""

            for f in files:
                if ignorar(f):
                    continue
                c = os.path.join(root, f)
                try:
                    max_mtime = max(max_mtime, os.path.getmtime(c))
                except OSError:
                    pass
                it = novo_arquivo(c)
                if it:
                    g.setdefault(rel_root, []).append(it)

            if rel_root != "":
                g.setdefault(rel_root, [])

        g.setdefault("", [])
        estrutura = [dict(nome=n, itens=sorted(g[n], key=lambda i: i["titulo"].lower())) for n in sorted(g.keys(), key=str.lower)]
        return max_mtime, estrutura

class GerenciadorSeguranca:
    @staticmethod
    def salvar_usr(nome, senha):
        usrs = GerenciadorSeguranca.obter_usuarios()
        if nome in usrs: return False

        if USAR_BCRYPT:
            salt = bcrypt.gensalt()
            hashed = bcrypt.hashpw(senha.encode(), salt)
            usrs[nome] = f"{salt.decode()}:{hashed.decode()}"
        else:
            salt = os.urandom(16)
            h = hashlib.sha256(salt + senha.encode("utf-8")).hexdigest()
            usrs[nome] = f"{salt.hex()}:{h}"

        with open(os.path.join(raiz, "_usuarios.json"), "w", encoding="utf-8") as f:
            json.dump(usrs, f, ensure_ascii=False)
        return True

    @staticmethod
    def obter_usuarios():
        arq = os.path.join(raiz, "_usuarios.json")
        if not os.path.isfile(arq): return {}
        with open(arq, "r", encoding="utf-8") as f:
            return json.load(f)

    @staticmethod
    def validar_login(nome, senha):
        usrs = GerenciadorSeguranca.obter_usuarios()
        armazenado = usrs.get(nome)

        if not armazenado:
            return False

        try:
            if USAR_BCRYPT:
                salt_hex, h_armazenado = armazenado.split(":", 1)
                salt = salt_hex.encode()
                hashed = bcrypt.hashpw(senha.encode(), salt)
                return hashed.decode() == h_armazenado
            else:
                salt_hex, h_armazenado = armazenado.split(":", 1)
                salt = bytes.fromhex(salt_hex)
                h = hashlib.sha256(salt + senha.encode("utf-8")).hexdigest()
                return h == h_armazenado
        except (ValueError, AttributeError):
            return False

class ErroUso(Exception):
    def __init__(self, msg, st=400):
        super().__init__(msg)
        self.st = st

def obter_usuarios():
    return GerenciadorSeguranca.obter_usuarios()

def salvar_usr(nome, senha):
    return GerenciadorSeguranca.salvar_usr(nome, senha)

def validar_login(nome, senha):
    return GerenciadorSeguranca.validar_login(nome, senha)

def relativo(c):
    return os.path.relpath(c, raiz).replace(os.sep, "/")

def ignorar(nome):
    return nome.startswith(("_", "."))

def data_de(c):
    return datetime.fromtimestamp(os.path.getmtime(c)).strftime("%d/%m/%Y")

def novo_site(pasta):
    indice = os.path.join(pasta, "index.html")
    if not os.path.isfile(indice):
        return None
    with open(indice, "rb") as f:
        dados = f.read()
    titulo = os.path.basename(pasta)
    m = RE_TITULO.search(dados)
    if m:
        t = html.unescape(m.group(1).decode("utf-8", "replace")).strip()
        titulo = t or titulo
    d = RE_OLHO.search(dados.decode("utf-8", "replace"))
    disc = html.unescape(d.group(1)).strip() if d else ""
    return disc, dict(tipo="Site", titulo=titulo, caminho=relativo(indice), data=data_de(indice))

def novo_arquivo(c):
    nome, ext = os.path.splitext(os.path.basename(c))
    t = TIPOS.get(ext.lower())
    return dict(tipo=t, titulo=nome, caminho=relativo(c), data=data_de(c)) if t else None

def dentro_da_raiz(rel):
    c = os.path.normpath(os.path.join(raiz, rel.lstrip("/\\").replace("/", os.sep)))
    try:
        return c if os.path.commonpath([raiz, c]) == raiz else ""
    except ValueError:
        return ""

def limpar(t):
    t = " ".join(RE_PROIBIDO.sub(" ", t or "").split())
    t = t.rstrip(". ").lstrip("._ ")
    return t[:80].strip()

def limpar_caminho(t):
    t = str(t or "")
    partes = []
    for p in t.replace("\\", "/").split("/"):
        l = limpar(p)
        if l: partes.append(l)
    return "/".join(partes)

def escolher_arquivos():
    import tkinter
    from tkinter import filedialog
    r = tkinter.Tk()
    r.withdraw()
    r.attributes("-topmost", True)
    r.update()
    try:
        return list(filedialog.askopenfilenames(parent=r, title="Escolha o estudo para adicionar", filetypes=[("Estudos", "*.zip *.pdf *.pptx *.docx *.xlsx *.apkg"), ("Todos os arquivos", "*.*")]))
    finally:
        r.destroy()

def adicionar(origem, disc, substituir):
    nome_arq = os.path.basename(origem)
    base, ext = os.path.splitext(nome_arq)
    ext = ext.lower()
    disc = limpar_caminho(disc)

    if ext != ".zip" and ext not in TIPOS:
        raise ErroUso("Esse tipo de arquivo não é aceito. Use ZIP, PDF, PPTX, DOCX, XLSX ou APKG.", 415)

    if ext != ".zip":
        base = limpar(base) or "Arquivo"
        destino = os.path.join(raiz, disc, base + ext)
        if os.path.exists(destino) and not substituir:
            raise ErroUso(f'"{base}" já existe neste local.', 409)
        os.makedirs(os.path.dirname(destino), exist_ok=True)
        shutil.copy2(origem, destino)
        return base

    try:
        z = zipfile.ZipFile(origem)
    except (zipfile.BadZipFile, OSError):
        raise ErroUso("Não foi possível ler esse zip.")
    tmp = os.path.join(raiz, "_temp", uuid.uuid4().hex)
    try:
        with z:
            nomes = [i.filename.replace("\\", "/") for i in z.infolist()]
            indices = [n for n in nomes if n.rsplit("/", 1)[-1].lower() == "index.html" and not n.startswith("__MACOSX/")]
            if not indices:
                raise ErroUso("Esse zip não tem um site dentro: falta o arquivo index.html.", 422)
            prefixo = min(indices, key=lambda n: n.count("/"))[: -len("index.html")]
            for i in z.infolist():
                n = i.filename.replace("\\", "/")
                if not n.startswith(prefixo) or n.endswith("/") or stat.S_ISLNK(i.external_attr >> 16):
                    continue
                partes = n[len(prefixo):].split("/")
                if ".." in partes or ":" in n or n.startswith("/"):
                    raise ErroUso("Esse zip tem caminhos inválidos e foi recusado.", 422)
                destino = os.path.join(tmp, *partes)
                os.makedirs(os.path.dirname(destino), exist_ok=True)
                with z.open(i) as e, open(destino, "wb") as s:
                    shutil.copyfileobj(e, s)
        site = novo_site(tmp)
        if not site:
            raise ErroUso("Esse zip não tem um site válido.", 422)
        titulo = site[1]["titulo"]
        disc_zip = disc or limpar_caminho(site[0])
        pasta = limpar(titulo) or limpar(base) or "Estudo"
        destino = os.path.join(raiz, disc_zip, pasta)

        if os.path.exists(destino):
            if not substituir:
                raise ErroUso(f'"{titulo}" já existe neste local.', 409)
            shutil.rmtree(destino)
        os.makedirs(os.path.dirname(destino), exist_ok=True)
        os.replace(tmp, destino)
        return titulo
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
        try:
            os.rmdir(os.path.join(raiz, "_temp"))
        except OSError:
            pass

def abrir_padrao(c):
    if sys.platform == "win32":
        os.startfile(c)
    elif sys.platform == "darwin":
        subprocess.call(["open", c])
    else:
        subprocess.call(["xdg-open", c])

def abrir_janela(url):
    bases = [os.environ.get(k, "") for k in ("ProgramFiles(x86)", "ProgramFiles", "LOCALAPPDATA")]
    candidatos = [os.path.join(b, *p) for b in bases if b for p in (("Microsoft", "Edge", "Application", "msedge.exe"), ("Google", "Chrome", "Application", "chrome.exe"))]
    for n in candidatos:
        if os.path.isfile(n):
            perfil = os.path.join(os.environ.get("LOCALAPPDATA", raiz), "BibliotecaDeEstudos", "perfil")
            os.makedirs(perfil, exist_ok=True)
            subprocess.Popen([n, "--app=" + url, "--user-data-dir=" + perfil, "--no-first-run", "--no-default-browser-check", "--disable-background-timer-throttling", "--window-size=1280,860"])
            return
    webbrowser.open(url)

class Servidor(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def responder(self, st, corpo=b"", tipo="text/plain; charset=utf-8", extra=None):
        if isinstance(corpo, str):
            corpo = corpo.encode("utf-8")
        self.send_response(st)
        self.send_header("Content-Type", tipo)
        self.send_header("Content-Length", str(len(corpo)))
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(corpo)

    def autenticado(self):
        cookie_header = self.headers.get("Cookie", "")
        cookies = {}
        if cookie_header:
            for item in cookie_header.split(";"):
                item = item.strip()
                if "=" in item:
                    key, value = item.split("=", 1)
                    cookies[key.strip()] = value.strip()
        token = cookies.get("sessao")
        return token and token in SESSOES_ATIVAS

    def permitido(self):
        o = self.headers.get("Origin")
        return self.headers.get("Host") == host and o == "http://" + host

    def corpo_json(self):
        return json.loads(self.corpo or b"{}")

    def do_GET(self):
        global ultimo_ping
        if self.headers.get("Host") != host:
            return self.responder(403, "recusado")

        cam = urllib.parse.unquote(urllib.parse.urlsplit(self.path).path)

        PUBLICOS = ("/", "/__vivo", "/__versao", "/__logo.png")
        if cam not in PUBLICOS and not self.autenticado():
            return self.responder(401, "Não autenticado")

        if cam == "/__vivo":
            ultimo_ping = time.time()
            return self.responder(200, raiz)
        if cam == "/__versao":
            return self.responder(200, VERSAO)
        if cam == "/__dados.json":
            # Reaproveita a mesma instância (com cache) em vez de criar uma nova a cada request
            return self.responder(200, json.dumps(dict(disciplinas=GERENCIADOR.listar()), ensure_ascii=False), "application/json; charset=utf-8", {"Cache-Control": "no-store"})
        if cam == "/__logo.png":
            return self.responder(200, base64.b64decode(LOGO_PNG), "image/png", {"Cache-Control": "no-store, no-cache, must-revalidate"})
        if cam == "/":
            return self.responder(200, PAGINA, MIME[".html"], {"Cache-Control": "no-cache"})

        c = dentro_da_raiz(cam)

        if not c or ignorar(os.path.basename(c)):
            return self.responder(404, "não encontrado")

        if os.path.isdir(c):
            if not cam.endswith("/"):
                return self.responder(302, "", extra={"Location": urllib.parse.quote(cam + "/")})
            c = os.path.join(c, "index.html")

        if not os.path.isfile(c):
            return self.responder(404, "não encontrado")

        with open(c, "rb") as f:
            dados = f.read()

        if c.lower().endswith(".html"):
            i = dados.lower().rfind(b"</body>")
            dados = dados[:i] + INJETADO + dados[i:] if i >= 0 else dados + INJETADO
            return self.responder(200, dados, MIME[".html"], {"Cache-Control": "no-cache"})

        return self.responder(200, dados, MIME.get(os.path.splitext(c)[1].lower(), "application/octet-stream"))

    def do_POST(self):
        self.corpo = self.rfile.read(int(self.headers.get("Content-Length") or 0))
        cam = urllib.parse.urlsplit(self.path).path

        if cam == "/__sair":
            # Antes só verificava o Host; agora exige também Origin válido (mesma
            # checagem usada nos demais endpoints), evitando que qualquer página
            # aberta no navegador consiga derrubar o servidor via POST simples.
            if not self.permitido():
                return self.responder(403, "recusado")
            self.responder(200)
            fila_gui.put("SAIR")
            return

        if not self.permitido():
            return self.responder(403, "recusado")

        try:
            if cam == "/__registrar":
                d = self.corpo_json()
                nome = (d.get("nome") or "").strip()
                senha = d.get("senha") or ""
                if not nome:
                    return self.responder(400, "Informe um nome de usuário.")
                if len(senha) < 6:
                    return self.responder(400, "Senha deve ter pelo menos 6 caracteres.")
                if salvar_usr(nome, senha):
                    return self.responder(200, "ok")
                return self.responder(409, "Esse nome de usuário já está em uso.")

            if cam == "/__login":
                d = self.corpo_json()
                if validar_login(d.get("nome"), d.get("senha")):
                    token = uuid.uuid4().hex
                    SESSOES_ATIVAS.add(token)
                    return self.responder(200, "ok", extra={"Set-Cookie": f"sessao={token}; Path=/; HttpOnly; SameSite=Lax"})
                return self.responder(401, "Nome ou senha incorretos.")

            if cam == "/__logout":
                return self.responder(200, "ok", extra={"Set-Cookie": "sessao=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT"})

            if not self.autenticado():
                return self.responder(401, "Não autenticado")

            if cam == "/__pasta":
                abrir_padrao(raiz)
                return self.responder(200)

            if cam == "/__criar_pasta":
                d = self.corpo_json()
                caminho = limpar_caminho(d.get("caminho", ""))
                if not caminho:
                    return self.responder(400, "Nome da pasta inválido.")
                destino = os.path.join(raiz, caminho)
                os.makedirs(destino, exist_ok=True)
                return self.responder(200, "ok")

            if cam == "/__excluir":
                c = dentro_da_raiz(self.corpo_json().get("c", ""))
                if not c or c == raiz:
                    return self.responder(403, "Ação não permitida.")
                try:
                    if os.path.isdir(c):
                        shutil.rmtree(c)
                    else:
                        os.remove(c)

                    pasta_pai = os.path.dirname(c)
                    while pasta_pai != raiz and os.path.isdir(pasta_pai) and not os.listdir(pasta_pai):
                        os.rmdir(pasta_pai)
                        pasta_pai = os.path.dirname(pasta_pai)

                    return self.responder(200, "ok")
                except Exception as ex:
                    logger.error(f"Erro ao excluir: {ex}")
                    return self.responder(500, f"Erro ao excluir: {str(ex)}")

            if cam == "/__mover":
                d = self.corpo_json()
                origem_rel = d.get("origem", "")
                destino_rel = d.get("destino", "")

                origem = dentro_da_raiz(origem_rel)
                if not origem or not os.path.exists(origem):
                    return self.responder(404, "Item de origem não encontrado.")

                destino_limpo = limpar_caminho(destino_rel)
                if not destino_limpo:
                    return self.responder(400, "Nome de destino inválido.")

                destino = os.path.join(raiz, destino_limpo)

                try:
                    if os.path.commonpath([raiz, os.path.abspath(destino)]) != raiz:
                        return self.responder(403, "Destino fora da biblioteca.")
                except ValueError:
                    return self.responder(403, "Destino inválido.")

                if os.path.exists(destino):
                    return self.responder(409, "Já existe um item com esse nome no destino.")

                try:
                    os.makedirs(os.path.dirname(destino), exist_ok=True)
                    shutil.move(origem, destino)

                    pasta_pai = os.path.dirname(origem)
                    while pasta_pai != raiz and os.path.isdir(pasta_pai) and not os.listdir(pasta_pai):
                        os.rmdir(pasta_pai)
                        pasta_pai = os.path.dirname(pasta_pai)
                except Exception as ex:
                    logger.error(f"Erro ao mover: {ex}")
                    return self.responder(500, f"Erro ao mover: {str(ex)}")

                return self.responder(200, "ok")

            if cam == "/__abrir":
                c = dentro_da_raiz(self.corpo_json().get("c", ""))
                if not c or os.path.splitext(c)[1].lower() not in TIPOS or not os.path.isfile(c):
                    return self.responder(403, "recusado")
                abrir_padrao(c)
                return self.responder(200)

            if cam == "/__escolher":
                if not trava_escolha.acquire(blocking=False):
                    return self.responder(409, "A janela de escolha já está aberta.")
                try:
                    fila_gui.put("ESCOLHER")
                    caminhos = fila_gui_resp.get()
                    if isinstance(caminhos, Exception):
                        raise caminhos
                finally:
                    trava_escolha.release()
                saida = []
                for p in caminhos:
                    k = uuid.uuid4().hex
                    escolhidos[k] = p
                    saida.append(dict(id=k, nome=os.path.basename(p)))
                return self.responder(200, json.dumps(saida, ensure_ascii=False), "application/json; charset=utf-8")

            if cam == "/__adicionar":
                d = self.corpo_json()
                origem = escolhidos.get(d.get("id"))
                if not origem:
                    return self.responder(403, "recusado")
                try:
                    t = adicionar(origem, d.get("disciplina", ""), bool(d.get("substituir")))
                    escolhidos.pop(d.get("id"), None)  # evita acumular entradas indefinidamente
                    return self.responder(200, t)
                except ErroUso as e:
                    return self.responder(e.st, str(e))

        except Exception as e:
            logger.error(f"Erro na requisição POST {cam}: {e}")
            return self.responder(500, str(e))
        self.responder(404, "não encontrado")

def consulting(url):
    with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(url, timeout=1) as r:
        return r.read().decode("utf-8", "replace")

def vigiar():
    while True:
        time.sleep(10)
        if time.time() - ESPERA > ultimo_ping:
            logger.info("Tempo de inatividade excedido. Encerrando...")
            fila_gui.put("SAIR")

def main(pasta=None):
    global raiz, host, ultimo_ping, GERENCIADOR
    raiz = os.path.realpath(pasta or os.path.dirname(os.path.abspath(sys.argv[0])))

    # --- CÓDIGO DE MIGRAÇÃO DE USUÁRIOS ANTIGOS ---
    arq_antigo = os.path.join(raiz, "_uszarios.json")
    arq_novo = os.path.join(raiz, "_usuarios.json")

    # Se o arquivo antigo existir e o novo ainda não, o sistema renomeia o arquivo
    if os.path.exists(arq_antigo) and not os.path.exists(arq_novo):
        try:
            os.rename(arq_antigo, arq_novo)
            logger.info("Ficheiro de utilizadores atualizado para _usuarios.json")
        except Exception as e:
            logger.error(f"Erro ao migrar ficheiro de utilizadores: {e}")
    # ----------------------------------------------

    # Instância única do gerenciador de arquivos, reaproveitada em todas as
    # requisições (o cache interno só funciona se a instância persistir).
    GERENCIADOR = GerenciadorArquivos(raiz)

    srv = None
    for p in range(PORTA, PORTA + 20):
        host = f"127.0.0.1:{p}"
        try:
            if consulting(f"http://{host}/__vivo") == raiz:
                if consulting(f"http://{host}/__versao") == VERSAO:
                    logger.info("Já existe uma instância rodando. Abrindo a interface...")
                    abrir_janela(f"http://{host}/")
                    return
                urllib.request.build_opener(urllib.request.ProxyHandler({})).open(urllib.request.Request(f"http://{host}/__sair", method="POST", headers={"Host": host, "Origin": f"http://{host}"}), timeout=1)
                time.sleep(0.5)
        except OSError:
            pass
        try:
            srv = ThreadingHTTPServer(("127.0.0.1", p), Servidor)
            logger.info(f"Servidor iniciado em http://{host}")
            break
        except OSError:
            continue
    if srv is None:
        raise RuntimeError("Nenhuma porta livre neste computador.")
    ultimo_ping = time.time()

    threading.Thread(target=srv.serve_forever, daemon=True).start()
    threading.Thread(target=vigiar, daemon=True).start()
    threading.Timer(0.2, abrir_janela, [f"http://{host}/"]).start()

    while True:
        tarefa = fila_gui.get()
        if tarefa == "SAIR":
            logger.info("Encerrando aplicação...")
            srv.shutdown()
            os._exit(0)
        elif tarefa == "ESCOLHER":
            try:
                fila_gui_resp.put(escolher_arquivos())
            except Exception as e:
                logger.error(f"Erro ao escolher arquivos: {e}")
                fila_gui_resp.put(e)

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        logger.critical(f"Erro fatal: {e}")
        import ctypes
        if sys.platform == "win32":
            ctypes.windll.user32.MessageBoxW(0, traceback.format_exc()[-900:], "Biblioteca de Estudos", 0x10)
        else:
            print(f"Erro Fatal: {traceback.format_exc()}", file=sys.stderr)