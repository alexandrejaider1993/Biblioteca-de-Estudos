<script>
let B={disciplinas:[]};
let pastaAtual = sessionStorage.getItem('pastaAtual') || "";
let itemMenu = null;
let animDelay = 0;
let buscaTimeout = null;

const esc=t=>String(t).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const url=c=>'/'+c.split('/').map(encodeURIComponent).join('/');
const norm=t=>String(t).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const $=i=>document.getElementById(i);
function post(u,d){return fetch(u,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d||{})})}

const tLogin=$('telaLogin'), tApp=$('telaApp'), bLogin=$('bLogin'), bCriar=$('bCriar');
const avL=$('avL'), avC=$('avC'), mostraAviso=(el,msg)=>{el.textContent=msg;el.hidden=!msg;el.classList.toggle('erro',true)};

$('btnIrCriar').onclick = () => { bLogin.hidden = true; bCriar.hidden = false; avC.hidden=true; $('cNome').focus(); };
$('btnIrLogin').onclick = () => { bCriar.hidden = true; bLogin.hidden = false; avL.hidden=true; $('lNome').focus(); };

$('fLogin').onsubmit = async (e) => {
    e.preventDefault(); avL.hidden=true;
    try {
        const r = await post('/__login', { nome: $('lNome').value, senha: $('lSenha').value });
        if (r.ok) { 
            sessionStorage.setItem('usrLogado', '1'); 
            tLogin.hidden = true; tApp.hidden = false; carregar(); 
        } else { mostraAviso(avL, await r.text()); }
    } catch(err) {
        mostraAviso(avL, 'Erro de conexão: ' + err.message);
    }
};

$('fCriar').onsubmit = async (e) => {
    e.preventDefault(); avC.hidden=true;
    const nome = $('cNome').value, senha = $('cSenha').value, conf = $('cConf').value;
    if (senha !== conf) return mostraAviso(avC, 'As senhas não coincidem.');
    if (senha.length < 6) return mostraAviso(avC, 'Senha deve ter pelo menos 6 caracteres.');
    
    try {
        const r = await post('/__registrar', { nome, senha });
        if (r.ok) { 
            avL.textContent = 'Conta criada! Faça login.'; avL.classList.remove('erro'); avL.hidden=false; 
            $('btnIrLogin').click(); 
        } else { mostraAviso(avC, await r.text()); }
    } catch(err) {
        mostraAviso(avC, 'Erro de conexão: ' + err.message);
    }
};

$('btnSair').onclick = async () => {
    try {
        await post('/__logout'); 
        sessionStorage.removeItem('usrLogado');
        sessionStorage.removeItem('pastaAtual');
        pastaAtual = "";
        tApp.hidden = true; tLogin.hidden = false; $('lSenha').value = '';
    } catch(err) {
        console.error('Erro ao sair:', err);
    }
};

const lista=$('lista'), busca=$('busca'), menuFlutuante=$('menuFlutuante');

window.abrirPasta = (caminho) => {
    pastaAtual = caminho;
    sessionStorage.setItem('pastaAtual', caminho);
    busca.value = ""; 
    desenhar();
};

window.prepararMover = (caminho, tipo) => {
    const partes = caminho.split('/');
    let nome = partes.pop();
    const pasta = partes.join('/');
    
    let ext = "";
    if (tipo !== 'pasta' && tipo !== 'Site') {
        const dotIndex = nome.lastIndexOf('.');
        if (dotIndex > 0) {
            ext = nome.substring(dotIndex);
            nome = nome.substring(0, dotIndex);
        }
    }
    
    $('mOrigem').value = caminho;
    $('mExtensao').value = ext;
    $('mNome').value = nome;
    $('mPasta').value = pasta ? pasta + '/' : '';
    
    const dirs = (B.disciplinas||[]).map(d=>d.nome).filter(n=>n!=="").map(n=>`<option value="${esc(n)}/">`).join('');
    $('discsMover').innerHTML = dirs;
    $('dlgMover').showModal();
};

function renderItem(i) {
    const isSite = i.tipo === 'Site';
    const caminhoOpcoes = isSite ? i.caminho.substring(0, i.caminho.lastIndexOf('/')) : i.caminho;
    animDelay++;
    
    return `<a class="item t-${esc(i.tipo)}" href="${esc(url(i.caminho))}" draggable="true" style="animation-delay:${animDelay * 0.03}s" ${isSite?' target="_blank"':`data-arquivo="${esc(i.caminho)}"`}>
        <div style="display:flex; justify-content:space-between; align-items:flex-start">
            <b>${esc(i.titulo)}</b>
            <span role="button" class="btn-opcoes" data-caminho="${esc(caminhoOpcoes)}" data-tipo="${esc(i.tipo)}" title="Options">⋮</span>
        </div>
        <span>${esc(i.tipo)} · ${esc(i.data)}</span>
    </a>`;
}

function desenhar(){
  const q = norm(busca.value.trim());
  animDelay = 0;
  
  if (q) {
      const ds = (B.disciplinas||[]).map(d => ({
          nome: d.nome,
          itens: (d.itens||[]).filter(i => norm(i.título+' '+d.nome+' '+i.tipo).includes(q))
      })).filter(d => d.itens.length);
      
      if (!ds.length) {
          lista.innerHTML = '<div class="vazio"><p>Nada encontrado para essa busca.</p></div>';
          return;
      }
      lista.innerHTML = ds.map(d => `
          <section class="disc">
              <h2>${d.nome === '' ? 'Raiz' : esc(d.nome)} <small>${d.itens.length}</small></h2>
              <div class="grade">
                  ${d.itens.map(renderItem).join('')}
              </div>
          </section>
      `).join('');
      
  } else {
      const d = (B.disciplinas||[]).find(x => x.nome === pastaAtual) || {itens: []};
      const arquivos = d.itens;
      
      const subpastas = (B.disciplinas||[]).filter(x => {
          if (x.nome === pastaAtual || x.nome === "") return false;
          if (pastaAtual === "") {
              return !x.nome.includes("/");
          } else {
              return x.nome.startsWith(pastaAtual + "/") && x.nome.lastIndexOf("/") === pastaAtual.length;
          }
      });

      let migalhasHtml = `<div class="migalhas"><a href="#" onclick="abrirPasta('');return false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg> Biblioteca</a>`;
      if (pastaAtual) {
          const partes = pastaAtual.split("/");
          let pathAcumulado = "";
          for (let i = 0; i < partes.length; i++) {
              pathAcumulado += (i===0?"":"/") + partes[i];
              migalhasHtml += ` <span class="sep">›</span> `;
              if (i === partes.length - 1) {
                  migalhasHtml += `<span>${esc(partes[i])}</span>`;
              } else {
                  migalhasHtml += `<a href="#" onclick="abrirPasta('${esc(pathAcumulado)}');return false">${esc(partes[i])}</a>`;
              }
          }
      }
      migalhasHtml += `</div>`;

      if (arquivos.length === 0 && subpastas.length === 0 && pastaAtual === "") {
          lista.innerHTML = migalhasHtml + '<div class="vazio"><h2>Sua biblioteca ainda está vazia</h2><p>Clique em <b>Adicionar estudo</b> para enviar arquivos, ou <b>Nova Pasta</b> para organizar.</p></div>';
          return;
      }

      let html = migalhasHtml + `<div class="grade">`;
      
      subpastas.forEach(sp => {
          animDelay++;
          const nomePasta = sp.nome.split("/").pop();
          html += `<a class="item t-Pasta" href="#" data-pasta="${esc(sp.nome)}" draggable="true" style="animation-delay:${animDelay * 0.03}s">
              <div style="display:flex; justify-content:space-between; align-items:flex-start">
